--[[--
ApertureProbe
=============

Reports the lens / aperture metadata carried by an image, and optionally dumps
it to disk.

Fusion attaches metadata to images as a plain Lua table hanging off the Image
object (Image.Metadata, which is nil when the image carries none). Which keys
turn up is down to the media format and to whichever node decoded it. BRAW from
a Blackmagic camera carries a lot, including "aperture", "focal_length" and
"lens_type", which is what makes a metadata-driven aperture correction possible
in the first place.

This tool passes its input straight through untouched and prints what it finds
to the Console (Fusion page -> Workspace -> Console).

Logging to disk is off until a Log Directory is set. Setting one also writes:

    <dir>/<clip>.csv    one row per field per frame: frame,field,value
    <dir>/<clip>.log    the same text that goes to the Console

The Console report is a live diagnostic and is gated by the Report control. The
files are a data capture, so they record every frame that renders, exactly once
each, regardless of that setting -- scrub or render the clip and the CSV fills
in behind you.
--]]--

FuRegisterClass("ApertureProbe", CT_Tool, {
	REGS_Name             = "Aperture Probe",
	REGS_Category         = "Fuses\\Metadata",
	REGS_OpIconString     = "APrb",
	REGS_OpDescription    = "Reports any lens/aperture metadata carried by an image",
	REG_NoMotionBlurCtrls = true,
	REG_NoBlendCtrls      = true,
	REG_OpNoMask          = true,
	REG_NoPreCalcProcess  = true,
	REG_SupportsDoD       = true,
	REG_Fuse_NoJIT        = true,
})

-- Key fragments denoting the aperture itself. Keys are normalised to lowercase
-- alphanumerics before matching, so "F-Number", "f_stop" and "FNumber" all
-- collapse onto the same needle.
local APERTURE_KEYS = {
	"aperture", "fnumber", "fstop", "tstop", "tnumber", "iris", "apex",
}

-- A wider net: fields describing the lens or the exposure. Useful context even
-- when the aperture itself is absent, and a hint about what the camera does
-- bother to tag. Short fragments are avoided here on purpose -- "nd" would
-- match "Vendor", "av" would match "Average".
local LENS_KEYS = {
	"lens", "focal", "zoom", "focus", "exposure", "shutter",
	"iso", "asa", "gain", "whitebalance", "kelvin", "colortemp",
}

local MAX_DEPTH = 8

local function normalise(key)
	return (tostring(key):lower():gsub("[^%a%d]", ""))
end

local function matches(key, needles)
	local flat = normalise(key)
	for _, needle in ipairs(needles) do
		if flat:find(needle, 1, true) then
			return true
		end
	end
	return false
end

-- Metadata values may themselves be tables -- Fusion turns dotted field names
-- such as "Stereo.Method" into nested tables -- so walk the tree and emit
-- dotted paths. Guards against cycles and runaway nesting because this is
-- reading data we did not create.
local function flatten(tbl, prefix, out, seen, depth)
	if depth > MAX_DEPTH then
		out[#out + 1] = { key = prefix .. "*", value = "<nested deeper than " .. MAX_DEPTH .. " levels>" }
		return out
	end

	seen[tbl] = true

	local keys = {}
	for k in pairs(tbl) do
		keys[#keys + 1] = k
	end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)

	for _, k in ipairs(keys) do
		local v = tbl[k]
		local path = prefix .. tostring(k)

		if type(v) ~= "table" then
			out[#out + 1] = { key = path, value = tostring(v) }
		elseif seen[v] then
			out[#out + 1] = { key = path, value = "<circular reference>" }
		elseif next(v) == nil then
			out[#out + 1] = { key = path, value = "<empty table>" }
		else
			flatten(v, path .. ".", out, seen, depth + 1)
		end
	end

	seen[tbl] = nil
	return out
end

-- What counts as "worth reporting again": the shape of the metadata, plus the
-- values of the fields we actually care about. Deliberately excludes values
-- like TimeCode and Filename that change on every single frame.
local function signature(fields)
	local parts = {}
	for _, f in ipairs(fields) do
		if matches(f.key, APERTURE_KEYS) or matches(f.key, LENS_KEYS) then
			parts[#parts + 1] = f.key .. "=" .. f.value
		else
			parts[#parts + 1] = f.key
		end
	end
	return table.concat(parts, "\n")
end

local function toolName()
	local ok, attrs = pcall(function() return self:GetAttrs() end)
	if ok and type(attrs) == "table" and attrs.TOOLS_Name then
		return attrs.TOOLS_Name
	end
	return "ApertureProbe"
end

local function buildReport(frame, meta, fields, dumpAll)
	local aperture, lens, other = {}, {}, {}
	for _, f in ipairs(fields) do
		local line = "    " .. f.key .. " = " .. f.value
		if matches(f.key, APERTURE_KEYS) then
			aperture[#aperture + 1] = line
		elseif matches(f.key, LENS_KEYS) then
			lens[#lens + 1] = line
		else
			other[#other + 1] = line
		end
	end

	local out = {}
	out[#out + 1] = "-- Aperture Probe [" .. toolName() .. "] frame " .. tostring(frame) .. " --"

	if meta == nil then
		out[#out + 1] = "  no metadata at all (Image.Metadata is nil)"
	elseif type(meta) ~= "table" then
		out[#out + 1] = "  Image.Metadata is a " .. type(meta) .. ", not a table"
	elseif #fields == 0 then
		out[#out + 1] = "  metadata table present but empty"
	else
		out[#out + 1] = "  " .. #fields .. " field(s) total"

		if #aperture > 0 then
			out[#out + 1] = "  APERTURE:"
			for _, l in ipairs(aperture) do out[#out + 1] = l end
		else
			out[#out + 1] = "  APERTURE: none found"
		end

		if #lens > 0 then
			out[#out + 1] = "  lens / exposure:"
			for _, l in ipairs(lens) do out[#out + 1] = l end
		end

		if dumpAll and #other > 0 then
			out[#out + 1] = "  everything else:"
			for _, l in ipairs(other) do out[#out + 1] = l end
		end
	end

	return table.concat(out, "\n")
end

--
-- Optional logging to disk, for when reading the Console gets old.
--

-- Per-instance state. Each tool instance gets its own Lua state, so plain
-- locals are per-instance.
local lastSignature = nil
local logged = {}          -- frames already written, so re-renders don't duplicate
local headerDone = {}      -- CSV paths whose header has been dealt with
local ensuredDirs = {}
local truncatePending = false
local logErrorShown = false

local function csvEscape(s)
	s = tostring(s)
	if s:find('[",\n\r]') then
		return '"' .. s:gsub('"', '""') .. '"'
	end
	return s
end

local function reportLogError(path, err)
	-- Once per instance: a failing path would otherwise reprint every frame.
	if logErrorShown then return end
	logErrorShown = true
	print("-- Aperture Probe: cannot write to " .. tostring(path) .. "\n" ..
	      "   " .. tostring(err) .. "\n" ..
	      "   The Mac App Store build of Resolve is sandboxed and may be refused\n" ..
	      "   paths outside its container. Try a Log Directory it can write to.")
end

local function writeFile(path, text, mode)
	local f, err = io.open(path, mode)
	if not f then
		reportLogError(path, err)
		return false
	end
	f:write(text)
	f:close()
	return true
end

local function fileExists(path)
	local f = io.open(path, "r")
	if f then
		f:close()
		return true
	end
	return false
end

-- Lua has no mkdir, and a missing directory is the most likely reason a first
-- write fails, so take one shot at creating it. Failure is not fatal: the
-- write itself reports the real error.
local function ensureDir(dir)
	if ensuredDirs[dir] then return end
	ensuredDirs[dir] = true
	pcall(function() os.execute('mkdir -p "' .. dir .. '"') end)
end

-- Name the dumps after the clip, so probing a second clip doesn't append to
-- the first one's files.
local function clipName(fields)
	for _, f in ipairs(fields) do
		if f.key == "Filename" then
			local base = f.value:match("([^/\\]+)$")
			if base then
				base = base:gsub("%.[^.]+$", "")
				base = base:gsub("[^%w%-_.]", "_")
				if base ~= "" then
					return base
				end
			end
		end
	end
	return "aperture-probe"
end

local function writeLogs(dir, frame, fields, reportText)
	if logged[frame] then return end
	logged[frame] = true

	ensureDir(dir)

	local base = dir .. "/" .. clipName(fields)
	local csvPath = base .. ".csv"
	local logPath = base .. ".log"

	local mode = "a"
	if truncatePending then
		truncatePending = false
		mode = "w"
		headerDone[csvPath] = false
	end

	if not headerDone[csvPath] then
		headerDone[csvPath] = true
		if mode == "w" or not fileExists(csvPath) then
			if not writeFile(csvPath, "frame,field,value\n", mode) then return end
			mode = "a"
		end
	end

	local rows = {}
	for _, f in ipairs(fields) do
		rows[#rows + 1] = tostring(frame) .. "," .. csvEscape(f.key) .. "," .. csvEscape(f.value)
	end
	if #rows > 0 then
		-- One write per frame: Process can run on several threads at once, and
		-- a row at a time would let frames interleave mid-record.
		writeFile(csvPath, table.concat(rows, "\n") .. "\n", mode)
	end

	writeFile(logPath, reportText .. "\n", mode)
end

local function resetLogState()
	logged = {}
	headerDone = {}
	ensuredDirs = {}
	logErrorShown = false
end

function Create()
	InImage = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
	})

	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
	})

	InWhen = self:AddInput("Report", "Report", {
		LINKID_DataType = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default = 0.0,
		INP_Integer = true,
		{ CCS_AddString = "When It Changes", },
		{ CCS_AddString = "Every Frame", },
		{ CCS_AddString = "Never", },
		CC_LabelPosition = "Vertical",
	})

	InDumpAll = self:AddInput("List Every Field", "DumpAll", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1.0,
	})

	InAgain = self:AddInput("Report Again", "ReportAgain", {
		LINKID_DataType = "Text",
		INPID_InputControl = "ButtonControl",
		INP_DoNotifyChanged = true,
		INP_External = false,
	})

	-- Empty means no logging: the Console alone is enough most of the time,
	-- and a fuse that silently starts writing files would be rude.
	InLogDir = self:AddInput("Log Directory", "LogDir", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FileControl",
		INPS_DefaultText = "",
		FC_PathBrowse = true,
		FC_IsSaver = true,
		INP_DoNotifyChanged = true,
	})

	InResetLog = self:AddInput("Start Log Over", "ResetLog", {
		LINKID_DataType = "Text",
		INPID_InputControl = "ButtonControl",
		INP_DoNotifyChanged = true,
		INP_External = false,
	})
end

function NotifyChanged(inp, param, time)
	if inp == InAgain then
		-- Forget what we last saw so the next render reports from scratch.
		lastSignature = nil
	elseif inp == InResetLog then
		resetLogState()
		truncatePending = true
	elseif inp == InLogDir then
		-- A new destination starts a fresh capture rather than resuming.
		resetLogState()
	end
end

function Process(req)
	local img = InImage:GetValue(req)
	local frame = req:GetTime()

	local meta = img.Metadata
	local fields = {}
	if type(meta) == "table" then
		flatten(meta, "", fields, {}, 1)
	end

	-- When enabled, the files are a data capture: every frame exactly once and
	-- the complete field list, whatever the Console report is set to.
	local dir = InLogDir:GetValue(req).Value or ""
	if dir ~= "" then
		writeLogs(dir, frame, fields, buildReport(frame, meta, fields, true))
	end

	local when = InWhen:GetValue(req).Value
	if when == 2 then                            -- Never
		OutImage:Set(req, img)
		return
	end

	local sig = signature(fields)
	if when == 0 and sig == lastSignature then   -- When It Changes
		OutImage:Set(req, img)
		return
	end
	lastSignature = sig

	-- One print call: Process can run on several threads at once, and printing
	-- line by line would let reports interleave in the Console.
	print(buildReport(frame, meta, fields, InDumpAll:GetValue(req).Value > 0.5))

	OutImage:Set(req, img)
end

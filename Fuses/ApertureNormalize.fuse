--[[--
ApertureNormalize
=================

Undoes the exposure ramp of a variable-aperture zoom.

A lens sold as 10-22mm f/3.5-4.5 loses light as you zoom in: the maximum
aperture narrows from f/3.5 to f/4.5 across the zoom range, so a shot that
zooms also brightens or darkens, for reasons that have nothing to do with the
scene. Blackmagic cameras record the aperture per frame in BRAW metadata, so
the ramp can be measured rather than guessed at.

Illuminance at the sensor goes as 1/N^2 for an f-number N, so matching a frame
shot at N to what it would have been at the target aperture is a gain of
(N / target)^2 -- a pure multiply, applied in linear light.

This tool is meant to be safe to leave enabled on every clip. Anything it does
not positively understand is passed straight through, untouched and uncopied:
footage with no metadata, a lens that isn't in the database below, an aperture
it can't parse or that the lens couldn't have produced, or an image that isn't
in linear light. It says which of those happened in the Console, and the
Generate Report button writes the whole story to a file.
--]]--

FuRegisterClass("ApertureNormalize", CT_Tool, {
	REGS_Name             = "Aperture Normalize",
	REGS_Category         = "Fuses\\Metadata",
	REGS_OpIconString     = "ANrm",
	REGS_OpDescription    = "Normalises variable-aperture lenses to a target aperture",
	REG_NoMotionBlurCtrls = true,
	REG_OpNoMask          = true,
	REG_NoPreCalcProcess  = true,
	REG_SupportsDoD       = true,
	REG_Fuse_NoJIT        = true,
})

-- ---------------------------------------------------------------------------
-- Lens database
-- ---------------------------------------------------------------------------
--
-- Keyed by the "lens_type" metadata string. Lookup collapses whitespace and
-- ignores case, but is otherwise exact -- a lens that isn't listed here gets
-- passed through untouched, which is the entire point of the table: it is what
-- makes this filter safe to enable on every clip in a timeline. The Force On
-- Unknown Lenses control overrides that when you know better.
--
-- Per-lens fields:
--
--   aperture_range  {widest, narrowest} marked f-numbers. An aperture outside
--                   this couldn't have come from this lens, so it is treated
--                   as bad metadata and the frame is passed through.
--
--   stops           Optional {[f_number] = correction_in_stops}. The inverse
--                   square law assumes the marked f-number equals the actual
--                   transmission, which real glass only approximates; this is
--                   where measured deviation goes, added on top of the
--                   computed correction and linearly interpolated between the
--                   f-numbers given. Leave nil until it has actually been
--                   measured -- guessing here is worse than not correcting.
--
local LENSES = {
	["Canon EF-S 10-22mm f/3.5-4.5 USM"] = {
		aperture_range = { 3.5, 29 },
		stops = nil,
	},
}

-- Refuse to apply a correction larger than this. Nothing legitimate about a
-- variable-aperture zoom needs multiple stops; a number this big means the
-- metadata is wrong, and quietly blowing out a shot is worse than doing
-- nothing.
local MAX_STOPS = 3.0

-- Below this, pass the frame through instead of correcting it. A thousandth of
-- a stop is invisible, and skipping the correction skips a full-frame read and
-- write -- which matters, because a 6K frame is a few hundred megabytes and
-- cameras sit exactly on a marked aperture most of the time.
local NEGLIGIBLE_STOPS = 0.001

local MAX_DEPTH = 8

local function lensKey(s)
	s = tostring(s):lower()
	s = s:gsub("%s+", " ")
	s = s:gsub("^ +", ""):gsub(" +$", "")
	return s
end

-- Normalised view of the table above, built once.
local LENSES_BY_KEY = {}
for name, lens in pairs(LENSES) do
	LENSES_BY_KEY[lensKey(name)] = { name = name, lens = lens }
end

local function log2(x)
	return math.log(x) / math.log(2)
end

-- Accepts the shapes cameras actually write: "f3.5", "F/3.5", "3.5", "T2.8".
local function parseAperture(s)
	if type(s) ~= "string" and type(s) ~= "number" then return nil end
	local n = tostring(s):match("^%s*[fFtT]?%s*/?%s*(%d+%.?%d*)%s*$")
	return tonumber(n)
end

-- "10mm" -> 10. The camera reports apertures quantised to marked stops, but
-- the light a variable-aperture zoom actually passes ramps smoothly with zoom
-- position, so focal length is the finer-grained signal of the two.
local function parseFocal(s)
	if type(s) ~= "string" and type(s) ~= "number" then return nil end
	return tonumber(tostring(s):match("(%d+%.?%d*)"))
end

local function interpolateStops(tbl, n)
	if type(tbl) ~= "table" then return 0 end

	local keys = {}
	for k in pairs(tbl) do keys[#keys + 1] = k end
	if #keys == 0 then return 0 end
	table.sort(keys)

	if n <= keys[1] then return tbl[keys[1]] end
	if n >= keys[#keys] then return tbl[keys[#keys]] end

	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if n >= a and n <= b then
			return tbl[a] + (tbl[b] - tbl[a]) * ((n - a) / (b - a))
		end
	end

	return 0
end

-- Decides what to do with a frame. Returns either { skip = "reason" } or a
-- correction. Kept free of Fusion types so it can be tested without a host.
local function plan(meta, target, force)
	if type(meta) ~= "table" then
		return { skip = "the image carries no metadata" }
	end

	if type(target) ~= "number" or target <= 0 then
		return { skip = "the target aperture is not a usable f-number" }
	end

	local lensName = meta.lens_type
	local haveName = lensName ~= nil and tostring(lensName) ~= ""
	local entry = haveName and LENSES_BY_KEY[lensKey(lensName)] or nil

	if not entry and not force then
		if not haveName then
			return { skip = "the metadata has no lens_type" }
		end
		return { skip = 'lens "' .. tostring(lensName) .. '" is not in the lens database' }
	end

	local aperture = parseAperture(meta.aperture)
	if not aperture then
		-- Forcing can stand in for a missing lens database entry, but not for
		-- a missing aperture: there is nothing to compute a correction from.
		if meta.aperture == nil then
			return { skip = "the metadata has no aperture" }
		end
		return { skip = 'cannot read the aperture "' .. tostring(meta.aperture) .. '"' }
	end

	local range = entry and entry.lens.aperture_range
	if range and (aperture < range[1] or aperture > range[2]) then
		return { skip = string.format("f%s is outside the f%s-f%s this lens can do",
			tostring(aperture), tostring(range[1]), tostring(range[2])) }
	end

	-- A gain is only meaningful on linear light. Fusion reports the encoding
	-- in GammaSpace.Gamma, and for BRAW through a colour-managed comp it is 1.
	-- Anything else would need linearising first, which is a different job, so
	-- say so rather than silently applying a wrong correction. Forcing does not
	-- override this -- it is about unknown lenses, not wrong maths.
	local gammaSpace = meta.GammaSpace
	if type(gammaSpace) == "table" and gammaSpace.Gamma ~= nil then
		local gamma = tonumber(gammaSpace.Gamma)
		if gamma and math.abs(gamma - 1.0) > 0.001 then
			return { skip = string.format("the image is gamma %s encoded, not linear", tostring(gamma)) }
		end
	end

	local stops = 2 * log2(aperture / target)
	if entry then
		stops = stops + interpolateStops(entry.lens.stops, aperture)
	end

	if math.abs(stops) > MAX_STOPS then
		return { skip = string.format("a %.2f stop correction is too large to be believable", stops) }
	end

	if math.abs(stops) < NEGLIGIBLE_STOPS then
		return { skip = string.format("already at the target aperture (f%s)", tostring(aperture)) }
	end

	return {
		lens = entry and entry.name or (haveName and tostring(lensName) or "unidentified lens"),
		forced = entry == nil,
		aperture = aperture,
		target = target,
		stops = stops,
		gain = 2 ^ stops,
	}
end

local function toolName()
	local ok, attrs = pcall(function() return self:GetAttrs() end)
	if ok and type(attrs) == "table" and attrs.TOOLS_Name then
		return attrs.TOOLS_Name
	end
	return "ApertureNormalize"
end

-- The zoom position, and the focus distance alongside it: both bear on how
-- much light actually reaches the sensor, and neither is quantised the way the
-- reported aperture is.
local function zoomLine(decision)
	if not decision.focal then return nil end
	local line = "  zoom       : " .. tostring(decision.focal)
	if decision.distance then
		line = line .. "  (focus " .. tostring(decision.distance) .. ")"
	end
	return line
end

local function buildReport(frame, decision)
	local out = {}
	out[#out + 1] = "-- Aperture Normalize [" .. toolName() .. "] frame " .. tostring(frame) .. " --"

	if decision.skip then
		out[#out + 1] = "  passing through: " .. decision.skip
	else
		out[#out + 1] = "  lens       : " .. decision.lens ..
			(decision.forced and "  (forced, not in the lens database)" or "")
		out[#out + 1] = string.format("  aperture   : f%s -> target f%s",
			tostring(decision.aperture), tostring(decision.target))
		out[#out + 1] = string.format("  correction : %+.3f stops (gain %.4f)",
			decision.stops, decision.gain)
	end

	local zoom = zoomLine(decision)
	if zoom then out[#out + 1] = zoom end

	return table.concat(out, "\n")
end

-- What makes a report worth repeating. The frame number is deliberately not
-- part of it: on a zoom the aperture changes every few frames and that is
-- exactly what we want to see, but a static shot should report once.
local function signature(decision)
	local zoom = tostring(decision.focal) .. "|" .. tostring(decision.distance)
	if decision.skip then
		return "skip:" .. decision.skip .. "|" .. zoom
	end
	return string.format("%s|%s|%s|%s|%s", decision.lens, tostring(decision.aperture),
		tostring(decision.target), tostring(decision.forced), zoom)
end

-- ---------------------------------------------------------------------------
-- Deciding once per distinct set of inputs
-- ---------------------------------------------------------------------------
--
-- Playback asks for a decision every frame, but the inputs it depends on --
-- the lens, the aperture, the encoding, the controls -- change only every
-- several frames at most, and not at all on a static shot. Recomputing means
-- string matching and formatting for nothing, so keep the last answer.
--
-- The cache is a single table replaced wholesale rather than a set of fields
-- mutated in place: Process runs on several threads, and reading a half
-- updated cache would pair one frame's aperture with another's correction.

local cached = nil

local function decide(meta, target, force)
	local isTable = type(meta) == "table"
	local lensRaw = isTable and meta.lens_type or nil
	local apertureRaw = isTable and meta.aperture or nil
	local focalRaw = isTable and meta.focal_length or nil
	local distanceRaw = isTable and meta.distance or nil
	local gammaRaw = nil
	if isTable and type(meta.GammaSpace) == "table" then
		gammaRaw = meta.GammaSpace.Gamma
	end

	local c = cached
	if c and c.isTable == isTable and c.lens == lensRaw and c.aperture == apertureRaw
		and c.gamma == gammaRaw and c.target == target and c.force == force
		and c.focal == focalRaw and c.distance == distanceRaw then
		return c.decision
	end

	local decision = plan(meta, target, force)
	decision.focal = focalRaw
	decision.focalMm = parseFocal(focalRaw)
	decision.distance = distanceRaw
	decision.sig = signature(decision)

	-- Precomputed here rather than per frame: it depends only on the decision.
	if not decision.skip then
		decision.stampValues = {
			gain = string.format("%.6f", decision.gain),
			stops = string.format("%.4f", decision.stops),
			from = string.format("f%s", tostring(decision.aperture)),
			target = string.format("f%s", tostring(decision.target)),
			lens = decision.lens,
			forced = decision.forced and "1" or "0",
			focal = focalRaw and tostring(focalRaw) or nil,
			distance = distanceRaw and tostring(distanceRaw) or nil,
		}
	end

	cached = {
		isTable = isTable,
		lens = lensRaw,
		aperture = apertureRaw,
		focal = focalRaw,
		distance = distanceRaw,
		gamma = gammaRaw,
		target = target,
		force = force,
		decision = decision,
	}

	return decision
end

-- Record what was done in the output metadata, so a downstream tool shows the
-- correction alongside the values it came from.
local function stamp(img, decision)
	local meta = {}
	if type(img.Metadata) == "table" then
		-- Shallow copy: nested tables are shared but never mutated, and
		-- writing into the input's own table would corrupt a cached image.
		for k, v in pairs(img.Metadata) do meta[k] = v end
	end

	meta.aperture_normalize = decision.stampValues
	img.Metadata = meta
end

-- ---------------------------------------------------------------------------
-- Generate Report
-- ---------------------------------------------------------------------------

-- Walks nested metadata into dotted paths, guarding against cycles and runaway
-- nesting because this is data we did not create.
local function flatten(tbl, prefix, out, seen, depth)
	if depth > MAX_DEPTH then
		out[#out + 1] = prefix .. "* = <nested deeper than " .. MAX_DEPTH .. " levels>"
		return out
	end

	seen[tbl] = true

	local keys = {}
	for k in pairs(tbl) do keys[#keys + 1] = k end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)

	for _, k in ipairs(keys) do
		local v = tbl[k]
		local path = prefix .. tostring(k)

		if type(v) ~= "table" then
			out[#out + 1] = path .. " = " .. tostring(v)
		elseif seen[v] then
			out[#out + 1] = path .. " = <circular reference>"
		elseif next(v) == nil then
			out[#out + 1] = path .. " = <empty table>"
		else
			flatten(v, path .. ".", out, seen, depth + 1)
		end
	end

	seen[tbl] = nil
	return out
end

local function clipName(meta)
	if type(meta) == "table" and meta.Filename then
		local base = tostring(meta.Filename):match("([^/\\]+)$")
		if base then
			base = base:gsub("%.[^.]+$", "")
			base = base:gsub("[^%w%-_.]", "_")
			if base ~= "" then return base end
		end
	end
	return "clip"
end

local function timestamp()
	local ok, stamped = pcall(os.date, "%Y-%m-%d %H:%M:%S")
	if ok and stamped then return tostring(stamped) end
	return "unknown"
end

local function writeReport(dir, frame, meta, decision, target, force)
	local path = string.format("%s/aperture-normalize-%s-%s.txt", dir, clipName(meta), tostring(frame))

	local out = {}
	out[#out + 1] = "Aperture Normalize report"
	out[#out + 1] = "generated : " .. timestamp()
	out[#out + 1] = "tool      : " .. toolName()
	out[#out + 1] = "frame     : " .. tostring(frame)
	out[#out + 1] = ""
	out[#out + 1] = "settings"
	out[#out + 1] = "  target aperture        : f" .. tostring(target)
	out[#out + 1] = "  force on unknown lenses: " .. (force and "yes" or "no")
	out[#out + 1] = ""
	out[#out + 1] = "outcome"
	if decision.skip then
		out[#out + 1] = "  passed through, because " .. decision.skip
	else
		out[#out + 1] = "  lens       : " .. decision.lens ..
			(decision.forced and "  (forced, not in the lens database)" or "")
		out[#out + 1] = string.format("  aperture   : f%s -> target f%s",
			tostring(decision.aperture), tostring(decision.target))
		out[#out + 1] = string.format("  correction : %+.4f stops (gain %.6f)",
			decision.stops, decision.gain)
	end
	if decision.focal then
		out[#out + 1] = "  zoom       : " .. tostring(decision.focal) ..
			(decision.distance and ("  (focus " .. tostring(decision.distance) .. ")") or "")
	end
	out[#out + 1] = ""
	out[#out + 1] = "metadata"

	if type(meta) == "table" then
		local fields = flatten(meta, "", {}, {}, 1)
		if #fields == 0 then
			out[#out + 1] = "  (present but empty)"
		else
			for _, line in ipairs(fields) do
				out[#out + 1] = "  " .. line
			end
		end
	else
		out[#out + 1] = "  (none: Image.Metadata is nil)"
	end

	-- Lua has no mkdir, and a missing directory is the likeliest reason this
	-- fails, so take one shot at creating it before giving up.
	pcall(function() os.execute('mkdir -p "' .. dir .. '"') end)

	local f, err = io.open(path, "w")
	if not f then
		print("-- Aperture Normalize: cannot write " .. path .. "\n   " .. tostring(err) ..
		      "\n   A sandboxed Resolve may be refused paths outside its container.")
		return
	end
	f:write(table.concat(out, "\n") .. "\n")
	f:close()

	print("-- Aperture Normalize: wrote " .. path)
end

-- ---------------------------------------------------------------------------
-- Applying the gain
-- ---------------------------------------------------------------------------
--
-- Resolve composites on the GPU, so a fuse that touches pixels from Lua drags
-- the whole frame down to host memory and back. At 6K that is a few hundred
-- megabytes each way, every frame, which costs far more than the multiply. A
-- DCTL kernel keeps the work where the image already is.
--
-- The CPU path is kept as a fallback for hosts without a usable GPU, and can
-- be selected deliberately from the Processing control to compare the two.

ApertureGainParams = [==[
	float gain;
	int srcsize[2];
]==]

ApertureGainSource = [==[
__KERNEL__ void ApertureGainKernel(__CONSTANTREF__ ApertureGainParams *params,
                                   __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
	DEFINE_KERNEL_ITERATORS_XY(x, y)

	if (x < params->srcsize[0] && y < params->srcsize[1])
	{
		float4 col = _tex2DVecN(src, x, y, 15);

		// Alpha is coverage, not light, so it is deliberately left alone.
		col.x *= params->gain;
		col.y *= params->gain;
		col.z *= params->gain;

		_tex2DVec4Write(dst, x, y, col);
	}
}
]==]

-- Returns the corrected image, or nil and a reason. Every failure is a
-- fallback rather than an error, but which failure it was matters: "no such
-- function" means this build has no GPU fuse support at all, while a node that
-- will not run means the kernel itself is at fault and Fusion has logged why.
local function applyGainGPU(req, img, gain)
	if type(DVIPComputeNode) ~= "function" then
		return nil, "this build has no DVIPComputeNode, so GPU kernels are not available to fuses"
	end

	local out = Image({ IMG_Like = img })
	if not out then
		return nil, "could not allocate an output image"
	end

	local node = DVIPComputeNode(req, "ApertureGainKernel", ApertureGainSource,
		"ApertureGainParams", ApertureGainParams)
	if not node then
		return nil, "DVIPComputeNode returned nothing; if the kernel failed to compile, " ..
			"the reason is in the Console just above this"
	end

	local params = node:GetParamBlock(ApertureGainParams)
	if not params then
		return nil, "could not get the kernel parameter block"
	end

	params.gain = gain
	params.srcsize[0] = img.DataWindow:Width()
	params.srcsize[1] = img.DataWindow:Height()
	node:SetParamBlock(params)

	-- Point sampling in pixel coordinates: each pixel is read exactly once at
	-- its own position, so there is nothing to interpolate.
	node:AddSampler("RowSampler", TEX_FILTER_MODE_POINT, TEX_ADDRESS_MODE_CLAMP,
		TEX_NORMALIZED_COORDS_FALSE)
	node:AddInput("src", img)
	node:AddOutput("dst", out)

	if not node:RunSession(req) then
		return nil, "the kernel would not run; any compile error is in the Console just above this"
	end

	return out
end

-- The documented CPU pattern: copy, then multiply in place. Two passes over
-- the frame.
local function applyGainCopy(img, gain)
	local out = img:CopyOf()
	out:Gain(gain, gain, gain, 1.0)
	return out
end

-- One pass in principle -- it reads and writes the frame once, and skips the
-- alpha plane entirely -- but it goes through the general channel-boolean
-- machinery, which may well cost more than it saves. Kept selectable so the
-- two can be compared on real footage rather than argued about.
local function applyGainChannelOp(img, gain)
	return img:ChannelOpOf("Multiply", nil, { R = gain, G = gain, B = gain })
end

-- PROCESSING_PUBLISH does no pixel work at all: the image passes through
-- untouched and the gain is only published on the Gain output, for a native
-- tool such as BrightnessContrast to apply. Every other mode touches all of
-- the pixels from Lua, which on a 6K frame is several hundred megabytes of
-- allocate-and-copy per frame however cheap the multiply itself is.
local PROCESSING_GPU, PROCESSING_COPY, PROCESSING_CHANNELOP, PROCESSING_PUBLISH = 0, 1, 2, 3

-- Once the GPU path has failed there is no reason to expect it to work on the
-- next frame: the kernel either compiles on this machine or it does not.
-- Retrying per frame would cost a failed compile on top of the CPU work, which
-- is worse than never having tried.
local gpuUnavailable = false

local function applyGain(req, img, gain, mode)
	if mode == PROCESSING_GPU and not gpuUnavailable then
		-- pcall because a host missing the DCTL entry points entirely would
		-- raise rather than simply return nothing.
		local ok, out, reason = pcall(applyGainGPU, req, img, gain)
		if ok and out then return out end

		gpuUnavailable = true
		print("-- Aperture Normalize: GPU path unavailable, using the CPU from here on\n   " ..
			(ok and tostring(reason or "no reason given") or ("it raised: " .. tostring(out))))
	end

	if mode == PROCESSING_CHANNELOP then
		return applyGainChannelOp(img, gain)
	end
	return applyGainCopy(img, gain)
end

local lastSignature = nil
local reportPending = false

function Create()
	InImage = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
	})

	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
	})

	-- A second output, carrying the same correction as a plain number, so the
	-- multiply can be handed to a tool that does it on the GPU. Connect it to
	-- BrightnessContrast's Gain. It is set on every frame, including the ones
	-- this tool decides to skip, where it is 1.0 -- an output that went absent
	-- would leave whatever consumed it holding a stale value.
	OutGain = self:AddOutput("Gain", "Gain", {
		LINKID_DataType = "Number",
		LINK_Main = 2,
	})

	InTarget = self:AddInput("Target Aperture", "TargetAperture", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 4.0,
		INP_MinScale = 1.0,
		INP_MaxScale = 22.0,
		INP_MinAllowed = 0.5,
		INP_MaxAllowed = 64.0,
	})

	InForce = self:AddInput("Force On Unknown Lenses", "Force", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0.0,
	})

	InProcessing = self:AddInput("Processing", "Processing", {
		LINKID_DataType = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default = 0.0,
		INP_Integer = true,
		{ CCS_AddString = "GPU (falls back to CPU)", },
		{ CCS_AddString = "CPU: copy + gain", },
		{ CCS_AddString = "CPU: channel op", },
		{ CCS_AddString = "Off: publish gain only", },
		CC_LabelPosition = "Vertical",
	})

	InConsole = self:AddInput("Console Logging", "ConsoleLogging", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1.0,
	})

	InWhen = self:AddInput("Report", "Report", {
		LINKID_DataType = "Number",
		INPID_InputControl = "ComboControl",
		INP_Default = 0.0,
		INP_Integer = true,
		{ CCS_AddString = "When It Changes", },
		{ CCS_AddString = "Every Frame", },
		CC_LabelPosition = "Vertical",
	})

	InReportDir = self:AddInput("Report Folder", "ReportDir", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FileControl",
		INPS_DefaultText = "",
		FC_PathBrowse = true,
		FC_IsSaver = true,
	})

	InGenerate = self:AddInput("Generate Report", "GenerateReport", {
		LINKID_DataType = "Text",
		INPID_InputControl = "ButtonControl",
		INP_DoNotifyChanged = true,
		INP_External = false,
	})
end

function NotifyChanged(inp, param, time)
	if inp == InGenerate then
		-- NotifyChanged has no image to look at, so leave a note for the
		-- render that the button click is about to trigger.
		reportPending = true
	end
end

function Process(req)
	local img = InImage:GetValue(req)
	local meta = img.Metadata

	local target = InTarget:GetValue(req).Value
	local force = InForce:GetValue(req).Value > 0.5

	local decision = decide(meta, target, force)

	-- Tracking the zoom means a ramp reports at every distinct focal length
	-- rather than only where the aperture steps, which is a lot more lines --
	-- hence the master switch.
	if InConsole:GetValue(req).Value > 0.5 then
		local everyFrame = InWhen:GetValue(req).Value > 0.5
		if everyFrame or decision.sig ~= lastSignature then
			lastSignature = decision.sig
			print(buildReport(req:GetTime(), decision))
		end
	end

	if reportPending then
		reportPending = false
		local dir = InReportDir:GetValue(req).Value or ""
		if dir == "" then
			print("-- Aperture Normalize: set a Report Folder first")
		else
			writeReport(dir, req:GetTime(), meta, decision, target, force)
		end
	end

	local mode = InProcessing:GetValue(req).Value

	OutGain:Set(req, Number(decision.gain or 1.0))

	if decision.skip or mode == PROCESSING_PUBLISH then
		-- Pass the original image straight through: no copy, no metadata
		-- change, nothing for a downstream tool to notice. In publish mode
		-- that also means no metadata stamp, because writing one would need
		-- the copy this mode exists to avoid.
		OutImage:Set(req, img)
		return
	end

	local out = applyGain(req, img, decision.gain, mode)
	stamp(out, decision)

	OutImage:Set(req, out)
end
